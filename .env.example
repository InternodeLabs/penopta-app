# ---- Auth (Better Auth) ----

# Secret used by Better Auth (min 32 chars). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-a-long-random-value

# Public origin of this app (no trailing slash). Used for links, OAuth, and auth.
# Local: http://localhost:3200
APP_URL=http://localhost:3200

# Optional: only set if Better Auth must use a different origin than APP_URL.
# Defaults to APP_URL (then Vercel URL / localhost).
# BETTER_AUTH_URL=

# Google OAuth (Cloud Console → Web client)
# Authorized redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional passkey relying-party id (defaults to hostname of APP_URL)
# PASSKEY_RP_ID=localhost

# Optional: for `npm run auth:dump-user-map` (legacy Internode id checklist).
# Defaults to sibling ../portal-frontend/.env.production DATABASE_URL.
# PORTAL_DATABASE_URL=
# PORTAL_FRONTEND_ROOT=/path/to/portal-frontend

# ---- Database (Postgres) ----

# Postgres connection string.
#   Local dev : docker compose -> postgres://penopta:penopta@localhost:5434/penopta
#   Production: Neon (Vercel Marketplace sets DATABASE_URL; ignore the other aliases)
# Driver is chosen from the host: Neon → neon-http, else node-postgres.
# Override with DB_DRIVER=pg|neon if needed.
DATABASE_URL=postgres://penopta:penopta@localhost:5434/penopta

# Optional override for the Penopta Sync download button.
# Leave unset — the button already serves /downloads/Penopta-Sync.zip from this
# repo (committed under public/downloads/ via `npm run macos:publish`).
# Only set if you intentionally host the zip somewhere else.
# PENOPTA_SYNC_DOWNLOAD_URL=

# Optional: path to a built Penopta Sync.app if not using macos-build/
# PENOPTA_SYNC_APP=/path/to/Penopta Sync.app

# ---- Email (Azure Communication Services) ----
# Used for org invite notifications.
# AZURE_COMMUNICATION_EMAIL_CONNECTION_STRING=endpoint=https://….communication.azure.com/;accesskey=…
# Optional sender override (defaults to EMAIL_FROM, then DoNotReply@node-mailer.com)
# EMAIL_FROM=DoNotReply@node-mailer.com
# AZURE_COMMUNICATION_EMAIL_SENDER_ADDRESS=DoNotReply@node-mailer.com
