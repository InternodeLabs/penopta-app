# ---- Central auth (portal-frontend) integration ----

# Base URL of the portal-frontend central auth authority.
#   local dev : http://localhost:3000
#   stage     : https://app.internode.us
#   production: https://app.internode.ai
PORTAL_BASE_URL=http://localhost:3000

# Secret used to sign this app's session cookie (HMAC-SHA256).
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-generate-a-long-random-value

# Optional: absolute URL for the Penopta Sync macOS download button.
# Default is same-origin /downloads/Penopta-Sync.zip (committed under public/downloads/).
# PENOPTA_SYNC_DOWNLOAD_URL=https://github.com/sshadmand/penopta-macos/releases/latest/download/Penopta-Sync.zip

# ---- Database (Postgres) ----

# Postgres connection string.
#   Local dev : docker compose -> postgres://penopta:penopta@localhost:5434/penopta
#   Production: Neon (Vercel Marketplace sets DATABASE_URL; ignore the other aliases)
# Driver is chosen from the host: Neon → neon-http, else node-postgres.
# Override with DB_DRIVER=pg|neon if needed.
DATABASE_URL=postgres://penopta:penopta@localhost:5434/penopta

# ---- Email (Azure Communication Services) ----
# Same ACS emailer as portal-frontend. Used for org invite notifications.
# AZURE_COMMUNICATION_EMAIL_CONNECTION_STRING=endpoint=https://….communication.azure.com/;accesskey=…
# Optional sender override (defaults to EMAIL_FROM, then DoNotReply@node-mailer.com)
# EMAIL_FROM=DoNotReply@node-mailer.com
# AZURE_COMMUNICATION_EMAIL_SENDER_ADDRESS=DoNotReply@node-mailer.com
